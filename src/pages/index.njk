---
layout: base
permalink: /index.html
---

<main id="main" class="page-index">
    <h1>{% explodedText meta.siteName %}
    </h1>
    <h2 class="subtitle">{{ meta.siteDescription }}</h2>
    <ul class="links">
        {% for item in navigation.links %}
        <li>
            <a href="{{ item.href }}" target="_blank" rel="nofollow" aria-label="{{ item.label }}">{% svg item.icon %}</a>
        </li>
        {% endfor %}
    </ul>

    {% set itemList = collections.allPosts %}
    {% if itemList.length %}
    <section class="index-post">
        <h3>Latest blog posts</h3>
        {% asyncEach item in itemList.slice(0, 3) %}
            <h2><a href="{{ item.url }}">{{ item.data.title }}</a></h2>
        {% endeach %}
    </section>
    {% endif  %}
</main>

<aside class="index-nav">
    {% for item in navigation.top %}
        <a href="{{ item.url }}"><span>{{ item.text }}</span></a>
    {% endfor %}
</aside>


{% include "partials/ai-banner.njk" %}

{%- css "local" -%}
{%- include 'css/index.css' -%}
{%- endcss -%}

<script>
    document.querySelectorAll('h1 span').forEach(bit => {
        setTimeout(() => {
            bit.style.setProperty('transform', 'rotate(0deg)')
        }, 500 + Math.random() * 500);
    })
</script>