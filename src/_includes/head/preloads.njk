  href="/assets/fonts/National_Park/NationalPark-VariableFont_wght.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>

<link
  rel="preload"
  href="/assets/fonts/Playfair_Display/PlayfairDisplay-VariableFont_wght.ttf"
  as="font"
  type="font/ttf"
  crossorigin
